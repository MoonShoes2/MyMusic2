{
  "name": "mymusic2-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -s first -n api,web -c yellow,cyan \"npm:dev:functions\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:functions": "wrangler pages dev public --port 8788",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=mymusic2-web",
    "dev:cf": "wrangler pages dev dist --port 8788"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.163.0"
  }
}
